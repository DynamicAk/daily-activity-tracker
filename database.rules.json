{
  "rules": {
    ".read": false,
    ".write": false,
    "dailyTracker": {
      "users": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['snapshot', 'sync'])",
          "snapshot": {
            ".validate": "newData.isString()"
          },
          "sync": {
            "$device": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0"
            }
          },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
